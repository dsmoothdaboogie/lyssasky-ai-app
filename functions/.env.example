# Copy this file to `.env.local` (git-ignored) and fill in real values for local
# emulator / manual smoke-test runs. Never commit `.env.local`.

# Required to use the real Gemini image-editing provider. Without this set (or with
# config/app.generationMode left at the default 'mock'), runGeneration falls back to
# the mock provider and no external API call is made.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Overrides the Gemini image model id. Defaults to 'gemini-3.1-flash-image'.
# If the default 404s on a live run, try 'gemini-2.5-flash-image' (older, known-stable).
# Changing this only needs an emulator restart, not a rebuild.
GEMINI_IMAGE_MODEL=

# GCS bucket used for uploaded room photos + generated images. Defaults to
# 'demo-lyssasky.appspot.com' (see functions/src/admin.ts) if unset.
STORAGE_BUCKET=

# Base URL of the deployed web app, used to build absolute links (e.g. Stripe checkout
# success/cancel URLs). Defaults to 'http://localhost:5173' (see functions/src/checkout.ts)
# if unset.
APP_BASE_URL=
